{
  "name": "pear-crypt",
  "version": "1.0.0",
  "description": "Client-side encryption library (wire formats, KDF, AES-GCM)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "export:vectors": "UPDATE_CRYPTO_VECTORS=1 vitest run src/cryptoVectorsContract.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
